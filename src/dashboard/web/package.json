{
  "name": "rewindle-dashboard",
  "private": true,
  "version": "0.2.0-alpha.1",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "typecheck": "node ./node_modules/typescript/lib/tsc.js --noEmit",
    "build": "node ./node_modules/typescript/lib/tsc.js --noEmit && node ./node_modules/vite/bin/vite.js build",
    "build:demo": "node ./node_modules/typescript/lib/tsc.js --noEmit && node ./node_modules/vite/bin/vite.js build --mode demo --outDir ../build-output/demo --emptyOutDir",
    "build:setup": "node ./node_modules/typescript/lib/tsc.js --noEmit && node ./node_modules/vite/bin/vite.js build --config vite.setup.config.ts",
    "build:setup-demo": "node ./node_modules/typescript/lib/tsc.js --noEmit && node ./node_modules/vite/bin/vite.js build --config vite.setup.config.ts --mode setup-demo --outDir ../build-output/setup-demo --emptyOutDir",
    "dev": "vite --host 127.0.0.1",
    "dev:demo": "vite --host 127.0.0.1 --mode demo",
    "dev:setup": "vite --config vite.setup.config.ts --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "liveline": "^0.0.7",
    "lucide-react": "^0.577.0",
    "motion": "^13.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadow-plugin": "^2.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
